rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'owner' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'))
      );
    }

    function isLogistics() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'logistics')
      );
    }

    function isSeller() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller')
      );
    }

    function isDriver() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().role in ['customer', 'seller']
        && incoming().keys().hasOnly(['uid', 'email', 'role', 'name', 'createdAt']);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.price is number && data.price >= 0 &&
               data.stock is number &&
               data.minThreshold is number && data.minThreshold >= 0;
      }

      allow read: if true; // Public for Customer Portal
      allow create: if isAdmin() || isLogistics();
      allow update: if isSeller() || isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /categories/{catId} {
      allow read: if true; // Public for Customer Portal
      allow write: if isAdmin() || isLogistics();
    }

    match /stockMovements/{moveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /transactions/{txId} {
      allow read, list: if isSignedIn() && (
        isAdmin() || 
        isSeller() || 
        isLogistics() || 
        (resource != null && resource.data.customerId == request.auth.uid)
      );
      allow create: if isSignedIn();
      allow update, delete: if false; 
    }

    match /settings/{docId} {
      allow read: if true; // Public for Customer Portal configuration
      allow write: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isLogistics();
    }

    match /customers/{docId} {
      allow read: if isSignedIn() && (request.auth.uid == docId || isAdmin() || isLogistics() || isSeller());
      allow list: if isAdmin() || isLogistics() || isSeller();
      allow create: if isSignedIn() && request.auth.uid == docId
        && incoming().keys().hasOnly(['uid', 'name', 'email', 'phone', 'rut', 'address', 'createdAt', 'points', 'balance'])
        && incoming().email == request.auth.token.email;
      allow update: if isSignedIn() && (
        (request.auth.uid == docId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt'])) ||
        isAdmin() ||
        isSeller()
      );
      allow delete: if isAdmin();
    }
    
    match /expenses/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && 
        incoming().amount is number && 
        incoming().amount > 0 &&
        incoming().createdBy == request.auth.uid;
      allow update: if isAdmin() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['description', 'amount', 'category', 'date']);
      allow delete: if isAdmin();
    }

    match /cashRegisters/{regId} {
      allow read: if isSignedIn();
      allow create: if isSeller() &&
        incoming().status == 'open' &&
        incoming().openedBy == request.auth.uid &&
        incoming().openedAt == request.time;
      allow update: if isSeller() &&
        existing().status == 'open' &&
        (
          (incoming().status == 'closed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'expectedAmount', 'finalAmount', 'difference']))
          ||
          isAdmin()
        );
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isLogistics() || 
        isDriver() || 
        (resource != null && resource.data.customerId == request.auth.uid)
      );
      allow create, delete: if isAdmin() || isLogistics();
      allow update: if isAdmin() || isLogistics() || (
        isDriver() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentLat', 'currentLng', 'updatedAt', 'lastLocationUpdate', 'startedTransitAt', 'deliveredAt', 'locationSource'])
      );
    }

    match /client_notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /role_audit/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /redemptions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if false;
    }

    match /claims/{docId} {
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || isLogistics());
      allow update: if isAdmin() || isLogistics();
      allow delete: if false;
    }

    match /inventory_audits/{docId} {
      allow read, write: if isSignedIn();
    }

    match /cash_closures/{docId} {
      allow read, write: if isSignedIn();
    }

    match /system_config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
