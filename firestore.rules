rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'solier.elijah@gmail.com' ||
        request.auth.token.role == 'owner' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'))
      );
    }

    function isLogistics() {
      return isSignedIn() && (
        request.auth.token.email == 'solier.elijah@gmail.com' ||
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'logistics')
      );
    }

    function isSeller() {
      return isSignedIn() && (
        request.auth.token.email == 'solier.elijah@gmail.com' ||
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller')
      );
    }

    function isDriver() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().role in ['customer', 'seller']
        && incoming().keys().hasOnly(['uid', 'email', 'role', 'name', 'createdAt']);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.price is number && data.price >= 0 &&
               data.stock is number &&
               data.minThreshold is number && data.minThreshold >= 0;
      }

      allow read: if true; // Public for Customer Portal
      allow create: if isAdmin() || isLogistics();
      allow update: if isSeller() || isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /categories/{catId} {
      allow read: if true; // Public for Customer Portal
      allow write: if isAdmin() || isLogistics();
    }

    match /stockMovements/{moveId} {
      allow read: if isAdmin() || isSeller() || isLogistics();
      allow create: if isSignedIn() && (isAdmin() || isSeller() || isLogistics() || request.resource.data.type == 'sale');
      allow update, delete: if false;
    }

    match /transactions/{txId} {
      allow read, list: if isSignedIn() && (
        (resource != null && resource.data.customerId == request.auth.uid) ||
        isAdmin() || 
        isSeller() || 
        isLogistics()
      );
      // H5 fix: scope create — staff can create any transaction;
      // customers can only create their own (type=sale|app_purchase|redemption with their customerId).
      allow create: if isSignedIn() && (
        isAdmin() || isSeller() || isLogistics() ||
        (request.resource.data.type in ['sale', 'app_purchase', 'redemption'] &&
         request.resource.data.customerId == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if true; // Public for Customer Portal configuration
      allow write: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isLogistics();
    }

    match /customers/{docId} {
      // H-CRITICAL fix: was `if true` on read/list/create/update (PII leak — Ley 21.719).
      // Restored from canonical pre-incident-7 baseline + H6 hardening on create.
      allow read: if isSignedIn() && (
        request.auth.uid == docId || isAdmin() || isLogistics() || isSeller()
      );
      allow list: if isAdmin() || isLogistics() || isSeller();
      // H6 fix: force points and balance to 0 on self-create — prevents economic
      // escalation via crafted signup payload (e.g. balance: 999999999).
      allow create: if isSignedIn() && request.auth.uid == docId
        && incoming().keys().hasOnly(['uid', 'name', 'email', 'phone', 'rut', 'address', 'createdAt', 'points', 'balance'])
        && incoming().email == request.auth.token.email
        && incoming().points == 0
        && incoming().balance == 0;
      allow update: if isSignedIn() && (
        (request.auth.uid == docId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt'])) ||
        isAdmin() ||
        isSeller()
      );
      allow delete: if isAdmin();
    }
    
    match /expenses/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && 
        incoming().amount is number && 
        incoming().amount > 0 &&
        incoming().createdBy == request.auth.uid;
      allow update: if isAdmin() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['description', 'amount', 'category', 'date']);
      allow delete: if isAdmin();
    }

    match /cashRegisters/{regId} {
      allow read: if isSignedIn();
      allow create: if isSeller() &&
        incoming().status == 'open' &&
        incoming().openedBy == request.auth.uid &&
        incoming().openedAt == request.time;
      allow update: if isSeller() &&
        existing().status == 'open' &&
        (
          (incoming().status == 'closed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'expectedAmount', 'finalAmount', 'difference']))
          ||
          isAdmin()
        );
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow get: if isAdmin() || isLogistics() || (
        isDriver() && 
        resource != null && 
        resource.data.assignedDriverId == request.auth.uid
      ) || (
        !isDriver()
      );
      allow list: if isSignedIn() && (
        (resource != null && (resource.data.assignedDriverId == request.auth.uid || resource.data.customerId == request.auth.uid)) ||
        isAdmin() || 
        isLogistics()
      );
      allow create, delete: if isAdmin() || isLogistics();
      allow update: if isAdmin() || isLogistics() || (
        isDriver() && 
        resource != null && 
        resource.data.assignedDriverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentLat', 'currentLng', 'updatedAt', 'lastLocationUpdate', 'startedTransitAt', 'deliveredAt', 'locationSource', 'customerSignature', 'customerSignedName'])
      );
    }

    match /fcm_tokens/{tokenId} {
      // tokenId is the FCM registration token string (not the user's uid).
      // Doc shape: { token: string, userId: uid, role: "driver"|"customer"|"admin", updatedAt }
      allow get, list: if isAdmin() || isLogistics();
      // Hardened: writer must claim their own userId (prevents hijacking another user's push channel).
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Owner can delete their own tokens (logout/device cleanup); staff can delete any.
      allow delete: if isAdmin() || isLogistics() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /client_notifications/{docId} {
      // R2 fix: read scoped to recipient (admin/logistics see all, others only their own).
      allow read: if isSignedIn() && (
        isAdmin() || isLogistics() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      // R2 fix: only staff can write client notifications (was open to any signed-in).
      allow create, update: if isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /notifications/{docId} {
      // R3 fix: read restricted to staff (was open to any signed-in).
      allow read: if isAdmin() || isLogistics();
      // R3 fix: only staff can write internal notifications (was open to any signed-in).
      allow create, update: if isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /role_audit/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /redemptions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || resource.data.customerId == request.auth.uid;
      allow delete: if false;
    }

    match /claims/{docId} {
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || isLogistics());
      allow update: if isAdmin() || isLogistics();
      allow delete: if false;
    }

    match /inventory_audits/{docId} {
      allow read, write: if isAdmin() || isLogistics();
    }

    match /cash_closures/{docId} {
      allow read, write: if isAdmin() || isSeller();
    }

    match /system_config/{docId} {
      // Sprint 20 audit: was `read: if true` — flags like couponsSeeded/customerSeeding
      // were exposed publicly. Restricted to staff (seeding only runs from admin/manager/owner
      // session per App.tsx useEffect).
      allow read: if isAdmin() || isLogistics();
      allow write: if isAdmin();
    }

    // NEW-T1 fix: removed `/test/{docId}` rule — dead code leftover from
    // legacy `testConnection()` in firebase.ts (already removed in commit 7a9442b).
    // No client should hit /test; default-deny from §0 global safety net applies.
  }
}
