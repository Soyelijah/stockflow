rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'owner' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'))
      );
    }

    function isLogistics() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'logistics')
      );
    }

    function isSeller() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller')
      );
    }

    function isDriver() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver')
      );
    }

    // Tier 5.A3: explicit "internal workforce" check, excludes customer role.
    // Matches src/lib/roles.ts isStaff(). Used by /customers + future customer-facing
    // collections that should be readable by staff but NOT by other customers.
    function isStaff() {
      return isAdmin() || isLogistics() || isSeller() || isDriver();
    }

    function isCustomer() {
      return isSignedIn() && request.auth.token.get('role', '') == 'customer';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Multi-branch helpers (Tier 1.3) ---
    // userBranchId returns the branchId from the user's custom claim, or null if signed-out.
    // Cross-branch users (admin/owner/logistics by design) carry the "*" sentinel.
    function userBranchId() {
      return isSignedIn() ? request.auth.token.get('branchId', null) : null;
    }

    // isCrossBranch: user can read/write any branch's data.
    // Covers both the explicit "*" claim and role-based escalation (admin/owner).
    // Logistics role is included here per design decision §4.1 (centralised warehouse model).
    function isCrossBranch() {
      return userBranchId() == "*" ||
             isAdmin() ||
             (isSignedIn() && request.auth.token.get('role', '') == 'logistics');
    }

    // inMyBranch: true if user can access the given branchId.
    // Cross-branch users get unconditional true. Pinned users only match their own branch.
    function inMyBranch(branchId) {
      return isCrossBranch() || (userBranchId() != null && userBranchId() == branchId);
    }

    // Read-side branchId from the existing document. Falls back to "default" so legacy
    // docs created before Tier 1.2 backfill (unlikely after migration ran but defensive)
    // are treated as belonging to the default branch.
    function resourceBranch() {
      return resource != null ? resource.data.get('branchId', 'default') : 'default';
    }

    // Write-side branchId from the incoming payload. Same default fallback semantics.
    function incomingBranch() {
      return request.resource.data.get('branchId', 'default');
    }

    // Format validation for branchId on writes. Rejects the cross-branch sentinel "*"
    // because that's user-claim-only; a document must point to a concrete branch.
    function isValidBranchId(b) {
      return b is string && b.size() > 0 && b.size() <= 128 && b != "*";
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().role in ['customer', 'seller']
        && incoming().keys().hasOnly(['uid', 'email', 'role', 'branchId', 'name', 'createdAt']);
      // CRITICAL: role + branchId are server-managed via Cloud Function setUserRole
      // (which is the only path that writes the authoritative custom claim).
      // Allowing them from the client lets a signed-in user self-escalate the mirror
      // and bypass isAdmin()/isLogistics()/isSeller() checks that read from this doc.
      // Self can only touch cosmetic fields (name). Admin can also fix email typos.
      // Cloud Functions use firebase-admin SDK which bypasses rules — they keep full access.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name']))
        ||
        (isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']))
      );
    }

    // Multi-branch (Tier 1.0): /branches metadata.
    // Read: any signed-in user (for branch selector + badge).
    // Write: admin/owner only (managers cannot create or rename branches).
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Multi-branch (Tier 1.1 + Tier 1.3): per-branch stock.
    // Read: any signed-in user (catalog is shared within the retailer).
    // Write: cross-branch staff (admin/logistics), or seller for their own branch's stock
    //        (POS decrement during sale). Uses unified branchId helpers.
    match /product_stock/{stockId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        isValidBranchId(incomingBranch()) &&
        inMyBranch(incomingBranch()) &&
        (isCrossBranch() || isSeller());
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      // Catalog is global (single retailer's catalog shared across branches).
      // Per-branch inventory lives in /product_stock (Tier 1.1).
      allow read: if true; // Public for Customer Portal
      allow create: if isAdmin() || isLogistics();
      allow update: if isSeller() || isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /categories/{catId} {
      allow read: if true; // Public for Customer Portal
      allow write: if isAdmin() || isLogistics();
    }

    match /stockMovements/{moveId} {
      // Tier 1.3: scoped by branchId. Cross-branch staff see everything; pinned sellers
      // only see movements of their own branch.
      allow read: if isSignedIn() && (
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch()))
      );
      // Create: same scope. The "sale" exception (any signed-in) is removed — sales now
      // go through POS/MobilePOS which always have a seller session.
      allow create: if isSignedIn() &&
        isValidBranchId(incomingBranch()) &&
        inMyBranch(incomingBranch()) &&
        (isCrossBranch() || isSeller());
      // Movements are append-only (audit integrity).
      allow update, delete: if false;
    }

    match /transactions/{txId} {
      // Tier 1.3: scoped by branchId, with customer-self read preserved.
      // Customer can read their own transactions regardless of branch (they need to see
      // every purchase across the retailer's footprint).
      // Cross-branch staff see everything. Pinned sellers see only their own branch.
      // Tier 5.C.2 hotfix: pinned sellers must be able to `transaction.get()` a
      // non-existent transaction doc to perform the offline-sync idempotency check
      // (MobilePOS handleSyncOfflineSales). For non-existent docs `resource == null`
      // and `resourceBranch()` falls back to "default", which would reject every
      // pinned seller (branchId != "default") and break offline sync entirely.
      // Allowing `resource == null` leaks no data — there is no document to read.
      allow read, list: if isSignedIn() && (
        (resource != null && resource.data.customerId == request.auth.uid) ||
        isCrossBranch() ||
        (isSeller() && (resource == null || inMyBranch(resourceBranch())))
      );
      // Create — H5 + Tier 1.3:
      //   - Customer self: only if type in [sale, app_purchase, redemption] AND customerId == auth.uid
      //     (branchId on the doc must be a real branch — customer's order ends up in a sucursal).
      //   - Staff: scoped to their own branch (cross-branch users can write any).
      allow create: if isSignedIn() && isValidBranchId(incomingBranch()) && (
        (request.resource.data.type in ['sale', 'app_purchase', 'redemption'] &&
         request.resource.data.customerId == request.auth.uid) ||
        (isCrossBranch() && (isAdmin() || isLogistics() || isSeller())) ||
        (isSeller() && inMyBranch(incomingBranch()))
      );
      // Tier 2: narrow update window — admin (cross-branch) or pinned seller in own branch
      // can mark a sale as voided. ONLY these five fields may change. The original sale data
      // (productId, amount, customerId, timestamp, etc.) remains immutable for audit integrity.
      // The transaction must not be already voided (no double-void).
      allow update: if (isCrossBranch() || (isSeller() && inMyBranch(resourceBranch()))) &&
        existing().type == 'sale' &&
        existing().voided != true &&
        incoming().diff(existing()).affectedKeys().hasOnly(['voided', 'voidedAt', 'voidedBy', 'voidReason', 'refundId']) &&
        incoming().voided == true;
      allow delete: if false;
    }

    // Tier 2: refund records. One doc per voided transaction line. Acts as the durable
    // audit trail for "this transaction was reversed, by whom, when, why, points deducted,
    // payment-gateway reconciliation pending or done".
    match /refunds/{refundId} {
      allow read, list: if isSignedIn() && (
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch())) ||
        (resource != null && resource.data.customerId == request.auth.uid)
      );
      allow create: if isSignedIn() &&
        isValidBranchId(incomingBranch()) &&
        inMyBranch(incomingBranch()) &&
        (isCrossBranch() || isSeller());
      // Update narrowly allowed for the paymentReversed flag (finance manually confirms
      // the gateway refund). Cross-branch staff only.
      allow update: if isCrossBranch() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentReversed', 'paymentReversedAt']);
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if true; // Public for Customer Portal configuration
      allow write: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isLogistics();
    }

    match /customers/{docId} {
      // H-CRITICAL fix (Sprint 18-20): was `if true` on read/list/create/update
      // (PII leak — Ley 21.719). Locked down to self-read + staff.
      // Tier 5.A3: collapsed admin||logistics||seller into isStaff() helper.
      allow read: if isSignedIn() && (
        request.auth.uid == docId || isStaff()
      );
      allow list: if isStaff();
      // H6 fix (Sprint 19): force points and balance to 0 on self-create —
      // prevents economic escalation via crafted signup payload (e.g. balance: 999999999).
      // Tier 5.A3: password field is server-managed in Firebase Auth, never in
      // Firestore. Block it from create payloads as defense-in-depth.
      allow create: if isSignedIn() && request.auth.uid == docId
        && incoming().keys().hasOnly(['uid', 'name', 'email', 'phone', 'rut', 'address', 'createdAt', 'points', 'balance'])
        && incoming().email == request.auth.token.email
        && incoming().points == 0
        && incoming().balance == 0;
      // Tier 5.A3: also block 'password' field on updates (defense-in-depth —
      // self-update already restricts affected keys, but staff path used to be
      // wide open. Now staff cannot accidentally re-introduce plain-text pw).
      allow update: if isSignedIn() && (
        (request.auth.uid == docId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt']))
        ||
        (isStaff()
          && !('password' in incoming().diff(existing()).affectedKeys()))
      );
      allow delete: if isAdmin();
    }
    
    match /expenses/{docId} {
      // Tier 1.3: read scoped by branchId (was open to any signed-in).
      // Admin sees all; logistics sees all; pinned seller/manager sees only their branch.
      allow read: if isSignedIn() && (
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch()))
      );
      // Create still admin-only (anti-pattern §6.5: only operators with cost visibility book expenses).
      // Branch must be present and valid.
      allow create: if isAdmin() &&
        isValidBranchId(incomingBranch()) &&
        incoming().amount is number &&
        incoming().amount > 0 &&
        incoming().createdBy == request.auth.uid;
      allow update: if isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['description', 'amount', 'category', 'date']);
      allow delete: if isAdmin();
    }

    match /cashRegisters/{regId} {
      // Tier 1.3: scoped by branchId. Cross-branch staff see all; sellers see only their branch.
      allow read: if isSignedIn() && (
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch()))
      );
      // Create: seller opens his own register, in his own branch.
      allow create: if isSeller() &&
        incoming().status == 'open' &&
        incoming().openedBy == request.auth.uid &&
        incoming().openedAt == request.time &&
        isValidBranchId(incomingBranch()) &&
        inMyBranch(incomingBranch());
      // Update: close the register OR admin-override. Pinned sellers can only close their own.
      allow update: if (isSeller() && inMyBranch(resourceBranch())) &&
        existing().status == 'open' &&
        (
          (incoming().status == 'closed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'expectedAmount', 'finalAmount', 'difference']))
          ||
          isAdmin()
        );
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      // Tier 1.3: tightened the previous `!isDriver()` open clause (was overly permissive —
      // any non-driver signed-in could read every shipment). Now scoped by:
      //   - driver: only shipments assigned to them
      //   - customer: only their own
      //   - cross-branch staff (admin/owner/logistics): all
      //   - pinned seller/manager: shipments of their branch (for pickup awareness at the local store)
      allow get: if isSignedIn() && (
        (isDriver() && resource != null && resource.data.assignedDriverId == request.auth.uid) ||
        (resource != null && resource.data.customerId == request.auth.uid) ||
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch()))
      );
      allow list: if isSignedIn() && (
        (resource != null && (
          resource.data.assignedDriverId == request.auth.uid ||
          resource.data.customerId == request.auth.uid
        )) ||
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch()))
      );
      // Create + delete: cross-branch staff only (admin/logistics). branchId must be valid.
      allow create: if isCrossBranch() && (isAdmin() || isLogistics()) &&
        isValidBranchId(incomingBranch());
      allow delete: if isCrossBranch() && (isAdmin() || isLogistics());
      // Update: staff cross-branch OR driver-assigned (with narrow field allowlist).
      allow update: if isCrossBranch() ||
        (isDriver() &&
         resource != null &&
         resource.data.assignedDriverId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status', 'currentLat', 'currentLng', 'updatedAt', 'lastLocationUpdate', 
           'startedTransitAt', 'deliveredAt', 'locationSource', 'customerSignature', 
           'customerSignedName', 'signatureMetadata', 'failedDeliveryReason', 
           'failedAt', 'photoEvidenceUrl'
         ]) &&
         incoming().status in ['in_route', 'delivered', 'failed'] &&
         (incoming().status != 'delivered' || (
           incoming().get('customerSignature', '') is string && 
           incoming().get('customerSignature', '').size() > 0 &&
           incoming().get('customerSignature', '').size() < 200000
         )) &&
         (incoming().status != 'failed' || (
           incoming().get('failedDeliveryReason', '') is string && 
           incoming().get('failedDeliveryReason', '').size() > 0
         )) &&
         // Transiciones de estado válidas (impide deshacer entregas)
         ((existing().status == 'assigned' && incoming().status == 'in_route') ||
          (existing().status == 'in_route' && incoming().status in ['delivered', 'failed']) ||
          (existing().status == incoming().status)) &&
         // failedDeliveryReason debe ser un código válido (whitelist) o
         // "other:" + descripción libre con límite de tamaño
         (incoming().status != 'failed' || (
           incoming().failedDeliveryReason in [
             'address_not_found', 'recipient_not_available', 'recipient_rejected',
             'force_majeure', 'closed_or_no_access', 'wrong_address_data'
           ] ||
           (incoming().failedDeliveryReason.matches('^other:.+') &&
            incoming().failedDeliveryReason.size() < 250)
         )) &&
         // Si status=failed, photoEvidenceUrl es obligatorio (no solo en UI)
         (incoming().status != 'failed' ||
          (incoming().photoEvidenceUrl is string &&
           incoming().photoEvidenceUrl.matches('^https://.*'))));
    }

    match /fcm_tokens/{tokenId} {
      // tokenId is the FCM registration token string (not the user's uid).
      // Doc shape: { token: string, userId: uid, role: "driver"|"customer"|"admin", updatedAt }
      allow get, list: if isAdmin() || isLogistics();
      // Hardened: writer must claim their own userId (prevents hijacking another user's push channel).
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Owner can delete their own tokens (logout/device cleanup); staff can delete any.
      allow delete: if isAdmin() || isLogistics() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /client_notifications/{docId} {
      // R2 fix: read scoped to recipient (admin/logistics see all, others only their own).
      allow read: if isSignedIn() && (
        isAdmin() || isLogistics() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      // R2 fix: only staff can write client notifications (was open to any signed-in).
      allow create, update: if isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /notifications/{docId} {
      // R3 fix: read restricted to staff (was open to any signed-in).
      allow read: if isAdmin() || isLogistics();
      // R3 fix: only staff can write internal notifications (was open to any signed-in).
      allow create, update: if isAdmin() || isLogistics();
      allow delete: if isAdmin() || isLogistics();
    }

    match /role_audit/{docId} {
      allow read: if isAdmin();
      // Tier 5.C.2 hotfix: sellers may write a narrow whitelist of audit events
      // they originate themselves (POS offline-sync idempotency hits). Forging
      // other action types or impersonating another operator is rejected.
      allow create: if isAdmin() ||
        (isSeller() &&
         incoming().action == 'POS_OFFLINE_SYNC_IDEMPOTENT_SKIP' &&
         incoming().operatorUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /redemptions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || resource.data.customerId == request.auth.uid;
      allow delete: if false;
    }

    match /claims/{docId} {
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || isLogistics());
      allow update: if isAdmin() || isLogistics();
      allow delete: if false;
    }

    match /inventory_audits/{docId} {
      // Tier 1.3: keep admin/logistics-only access. Both are cross-branch by design,
      // so they see all audits. Pinned managers/sellers do not see audit history.
      // Branch validation on create.
      allow read: if isCrossBranch() && (isAdmin() || isLogistics());
      allow create, update: if isCrossBranch() && (isAdmin() || isLogistics()) &&
        isValidBranchId(incomingBranch());
      allow delete: if isAdmin();
    }

    match /cash_closures/{docId} {
      // Tier 1.3: scoped by branchId. Sellers see only their own branch's closures.
      // Admin (cross-branch) sees all.
      allow read: if isSignedIn() && (
        isCrossBranch() ||
        (isSeller() && inMyBranch(resourceBranch()))
      );
      allow create, update: if isSignedIn() &&
        isValidBranchId(incomingBranch()) &&
        (isCrossBranch() || (isSeller() && inMyBranch(incomingBranch())));
      allow delete: if isAdmin();
    }

    match /system_config/{docId} {
      // Sprint 20 audit: was `read: if true` — flags like couponsSeeded/customerSeeding
      // were exposed publicly. Restricted to staff (seeding only runs from admin/manager/owner
      // session per App.tsx useEffect).
      allow read: if isAdmin() || isLogistics();
      allow write: if isAdmin();
    }

    // NEW-T1 fix: removed `/test/{docId}` rule — dead code leftover from
    // legacy `testConnection()` in firebase.ts (already removed in commit 7a9442b).
    // No client should hit /test; default-deny from §0 global safety net applies.
  }
}
