rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers (Custom Claims Based) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      // Return the role from the custom claims, defaulting to 'customer' if not set
      return request.auth.token.role != null ? request.auth.token.role : 'customer';
    }

    function isOwner() {
      return isSignedIn() && getRole() == 'owner';
    }

    function isAdmin() {
      return isSignedIn() && (getRole() == 'admin' || isOwner());
    }

    function isManager() {
      return isSignedIn() && (getRole() == 'manager' || isAdmin());
    }

    function isSeller() {
      return isSignedIn() && (getRole() == 'seller' || getRole() == 'cashier' || isManager());
    }

    function isLogistics() {
      return isSignedIn() && (getRole() == 'logistics' || getRole() == 'inventory_manager' || isManager());
    }

    function isDriver() {
      return isSignedIn() && (getRole() == 'driver' || isManager());
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isManager());
      allow list: if isManager();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        incoming().keys().hasAll(['uid', 'email', 'name', 'createdAt']) &&
        incoming().uid == userId
      );
      // Solo el mismo usuario puede actualizar sus datos básicos. Solo admins pueden tocar el rol en db legacy.
      allow update: if (isAdmin()) ||
                   (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'phone', 'rut', 'birthday', 'address', 'updatedAt']));
    }

    match /products/{productId} {
      allow read: if true; // Public for Customer Portal
      allow create: if isLogistics();
      allow update: if isLogistics() || isSeller(); // Seller needs to reduce stock via runTransaction
      allow delete: if isManager();

      // Ocultamiento de costPrice (Costos)
      match /private/details {
        allow read: if isLogistics();
        allow write: if isLogistics();
      }
    }

    match /categories/{catId} {
      allow read: if true; // Public for Customer Portal
      allow write: if isLogistics();
    }

    match /stockMovements/{moveId} {
      allow read: if isLogistics() || isSeller();
      allow create: if isLogistics() || isSeller();
      allow update, delete: if isAdmin();
    }

    match /transactions/{txId} {
      // Un cliente solo puede ver sus transacciones. Vendedores pueden ver todas.
      allow read: if isSeller() || (isSignedIn() && existing().customerId == request.auth.uid);
      
      // Permitimos que invitados o clientes creen transacciones, pero con validación estricta
      allow create: if true;
      
      // Solo admins pueden modificar o borrar transacciones
      allow update, delete: if isAdmin(); 
    }

    match /settings/{docId} {
      allow read: if true; // Public for Customer Portal configuration
      allow write: if isManager();
    }

    match /suppliers/{docId} {
      allow read: if isLogistics();
      allow write: if isLogistics();
    }

    match /customers/{docId} {
      // Público para auth/verificación, pero listar solo para vendedores
      allow get: if true; 
      allow list: if isSeller();
      allow create: if true; // Registro de clientes
      allow update: if isSeller() || (isSignedIn() && request.auth.uid == docId);
      allow delete: if isAdmin();
    }
    
    match /expenses/{docId} {
      allow read: if isManager();
      allow create: if isManager() && 
        incoming().amount is number && 
        incoming().amount > 0 &&
        incoming().createdBy == request.auth.uid;
      allow update: if isManager() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['description', 'amount', 'category', 'date']);
      allow delete: if isAdmin();
    }

    match /cashRegisters/{regId} {
      allow read: if isSeller();
      allow create: if isSeller() &&
        incoming().status == 'open' &&
        incoming().openedBy == request.auth.uid &&
        incoming().openedAt == request.time;
      allow update: if isSeller() &&
        existing().status == 'open' &&
        (
          (incoming().status == 'closed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'expectedAmount', 'finalAmount', 'difference']))
          ||
          isManager()
        );
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true; // Clientes pueden leer para validar
      allow write: if isManager();
    }

    match /shipments/{shipmentId} {
      allow read: if isDriver() || isSeller();
      allow write: if isLogistics();
      allow update: if isDriver() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveryNotes', 'updatedAt']);
    }

    match /client_notifications/{docId} {
      allow read: if true;
      allow write: if isSignedIn() || isManager();
    }

    match /redemptions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /role_audit/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Solo se escribe desde backend (Cloud Functions / Admin SDK)
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
