rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shipments/by-driver/{driverId}/{shipmentId}/{allPaths=**} {
      // Read: Cualquier usuario autenticado (para auditoría interna)
      allow read: if request.auth != null;
      
      // Write: Solo el conductor asignado al envío, límite de 5MB, solo imágenes
      allow write: if request.auth != null && 
        request.auth.uid == driverId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    
    // Regla de respaldo para fotos de perfil existentes (Profile.tsx)
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
