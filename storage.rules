rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Dispatch evidence photos (DriverPWA failed-delivery flow).
    // Read: the owning driver OR staff auditors (claim-based). Other drivers /
    // sellers / customers / anon: denied. Evidence is audit material — drivers
    // cannot delete it (orphans from a failed-commit rollback are tolerated;
    // a proper server-side/admin cleanup is a separate lane).
    match /shipments/by-driver/{driverId}/{shipmentId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == driverId ||
         request.auth.token.get('role', '') in ['owner', 'admin', 'manager', 'logistics']);

      allow create, update: if request.auth != null &&
        request.auth.uid == driverId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    // Profile avatars (Profile.tsx). Subject-only read/write/delete; no staff read
    // (avatars display via the tokenized URL stored in Firestore, never SDK-read by
    // another user). Anon denied.
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Any other path: Storage default-deny (unauthenticated + unmapped paths).
  }
}
