node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
serviceAccountKey.json

# Functions build/runtime
functions/lib/
functions/node_modules/

# Devlmer Ecosystem Engine — ephemera (auto-added by install.sh)
.claude/__pycache__/
.claude/logs/
.claude/settings.local.json

# Local agent scaffolding (not part of the application — installed per-developer)
.claude/skills/
.claude/worktrees/
.agents/
.qwen/
.codex/
AGENTS.md

# Tier 5 migration artifacts — pre-migration data backups and runtime logs stay local.
# Backups contain PII (customer emails, RUTs); do NOT commit.
backups/
logs/

# Ad-hoc smoke / probe scripts written for one-off Tier 5 verification.
# They use admin SDK against prod and must NOT ship in the repo.
smoke-*.ts
smoke-*.cjs
probe-*.ts
probe-*.cjs

# react-doctor output
doctor-report.txt

# Capacitor Android platforms — generated by `npx cap add android` per variant.
# Tier 5.B introduces 3 variants (staff/client/driver) each with its own folder.
# Each developer regenerates locally (5-10s per variant). Tracking the entire
# Gradle scaffolding inflates the repo for minimal benefit. If team grows and
# we need shared native config, uncomment to start tracking.
android/
android-staff/
android-client/
android-driver/

# Tier 5.B per-variant build outputs
dist-staff/
dist-client/
dist-driver/

# Signing keystores — NEVER commit. Loss = loss of Play Store update ability.
*.jks
*.keystore
