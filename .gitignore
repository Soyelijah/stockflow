# react-doctor output
doctor-report.txt

# Capacitor Android platform — generated by `npx cap add android`. Each developer
# regenerates locally (5-10s). Tracking the entire Gradle scaffolding (50+ files)
# inflates the repo for minimal benefit. If team grows and we need shared native
# config (custom AndroidManifest, native plugins), uncomment to start tracking.
android/

# Signing keystores — NEVER commit. Loss = loss of Play Store update ability.
*.jks
*.keystore
